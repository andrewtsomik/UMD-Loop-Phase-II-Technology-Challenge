<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>urc_gui_phase2</name>
  <version>0.0.1</version>
  <description>Phase 2 (S1 Navigation GUI) for the URC robotics club challenge</description>
  <maintainer email="aggarwalsoham2008@gmail.com">soham</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>python3-pyqt5.qtwebengine</exec_depend>
  <!-- WGS84 <-> UTM. pyqtlet2 is pip-only (no rosdep key): pip install pyqtlet2 -->
  <exec_depend>python3-pyproj</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
