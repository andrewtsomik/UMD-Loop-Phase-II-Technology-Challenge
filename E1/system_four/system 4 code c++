#define SIGNAL_PIN 34

void setup() {
  Serial.begin(115200);
}

void loop() {

  // Read analog voltage
  int adcValue = analogRead(SIGNAL_PIN);

  // Convert 0-4095 ADC range to 0-255
  int signalValue = map(adcValue, 0, 4095, 0, 255);

  Serial.print("Signal value: ");
  Serial.println(signalValue);

  delay(10);
}
